# URL of the deployed backend (see server/README or the root README's
# "Backend" section). For local dev, point this at your local server:
VITE_API_BASE_URL=http://localhost:4000

# Set to "true" to show a simple holding page at every route instead of the
# store (useful while you're still finishing setup). Set back to "false" (or
# remove it) and redeploy to bring the real site back.
VITE_COMING_SOON=false
